# harness.env 模板 —— 复制为 harness.env 并填入真实值（harness.env 已被 .gitignore 排除）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_API_KEY=你的key
LLM_MODEL=deepseek-v4-flash

# 可选：字幕目录（默认 <项目根>/inbox）
# SUBTITLE_DIR=C:\path\to\subtitles
# 可选：Obsidian 输出根（默认 <本机vault>/07-AI学习/测试-B站笔记输出）
# OBSIDIAN_ROOT=C:\Users\you\Documents\Obsidian Vault\07-AI学习\测试-B站笔记输出
